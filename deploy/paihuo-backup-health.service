[Unit]
Description=Paihuo AI backup freshness and capacity gate
After=local-fs.target
OnFailure=paihuo-failure-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/lib/paihuo-ops
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/usr/local/lib/paihuo-ops
ExecStart=/usr/bin/python3 -m deploy.backup_health --database /var/lib/paihuo/data/contentcrew.db --backup-dir /var/backups/paihuo --max-age-hours 24 --attestation /var/lib/paihuo-upgrade/latest-periodic-backup.json
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/usr/local/lib/paihuo-ops /var/lib/paihuo/data /var/backups/paihuo /var/lib/paihuo-upgrade
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
